<p style="color: green"><%= notice %></p>

<% content_for :title, "Products" %>

<h1>Nos Produits Hashimoto Friendly</h1>

<div id="products">
  <% @products.each do |product| %>
    <%= render product %>
    <p><strong>Prix :</strong> <%= number_to_currency(product.price, unit: "€", separator: ",", delimiter: " ") %></p>
    <p>
      <%= link_to "Voir ce produit", product %>
    </p>
  <% end %>
</div>

<%= link_to "Nouveau produit", new_product_path %>
