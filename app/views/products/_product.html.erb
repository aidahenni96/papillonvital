<div id="<%= dom_id product %>">
  <p>
    <strong>Nom:</strong>
    <%= product.name %>
  </p>

  <p>
    <strong>Description:</strong>
    <%= product.description %>
  </p>

  <p>
    <strong>Stock:</strong>
    <%= product.stock %>
  </p>

  <p>
    <strong>Image url:</strong>
    <%= product.image_url %>
  </p>

  <p>
    <strong>Categorie:</strong>
    <%= product.category_id %>
  </p>

</div>
